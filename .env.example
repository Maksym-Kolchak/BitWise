# Copy to .env on YOUR computer; never commit the resulting .env.
# Generate a unique key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
# Empty = app.db in this project folder. Test migration on a COPY first.
DATABASE_URL=
PUBLIC_URL=http://127.0.0.1:5000
# Empty mail settings: local development prints links to YOUR terminal.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Bitwise
MAIL_BACKGROUND=0
BREVO_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional AI services; leave empty to disable them.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
